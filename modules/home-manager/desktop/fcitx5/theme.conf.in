AccentColorField=

[Metadata]
Name=ink-and-frost
Version=1
Author=yuta
Description=Fcitx5 theme aligned with alacritty/waybar/rofi colors
ScaleWithDPI=True

[InputPanel]
Font=Hack Nerd Font 12
NormalColor=@white@
HighlightColor=@fg@
HighlightBackgroundColor=@selection@
HighlightCandidateColor=@fg@
EnableBlur=False
FullWidthHighlight=True
Spacing=6
PageButtonAlignment=Bottom

[InputPanel/Background]
Image=
Color=@bg@
BorderColor=@selection@
BorderWidth=1
Overlay=
Gravity="Top Left"
OverlayOffsetX=0
OverlayOffsetY=0
HideOverlayIfOversize=False

[InputPanel/Background/Margin]
Left=6
Right=6
Top=6
Bottom=6

[InputPanel/Background/OverlayClipMargin]
Left=0
Right=0
Top=0
Bottom=0

[InputPanel/Highlight]
Image=
Color=@selection@
BorderColor=@selection@
BorderWidth=0
Overlay=
Gravity="Top Left"
OverlayOffsetX=0
OverlayOffsetY=0
HideOverlayIfOversize=False

[InputPanel/Highlight/Margin]
Left=6
Right=6
Top=4
Bottom=4

[InputPanel/Highlight/OverlayClipMargin]
Left=0
Right=0
Top=0
Bottom=0

[InputPanel/Highlight/HighlightClickMargin]
Left=0
Right=0
Top=0
Bottom=0

[InputPanel/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/TextMargin]
Left=10
Right=10
Top=6
Bottom=6

[InputPanel/PrevPage]
Image=

[InputPanel/PrevPage/ClickMargin]
Left=0
Right=0
Top=0
Bottom=0

[InputPanel/NextPage]
Image=

[InputPanel/NextPage/ClickMargin]
Left=0
Right=0
Top=0
Bottom=0

[InputPanel/ShadowMargin]
Left=0
Right=0
Top=0
Bottom=0

[Menu]
NormalColor=@white@
HighlightCandidateColor=@fg@
Spacing=4

[Menu/Background]
Image=
Color=@bg@
BorderColor=@selection@
BorderWidth=1
Overlay=
Gravity="Top Left"
OverlayOffsetX=0
OverlayOffsetY=0
HideOverlayIfOversize=False

[Menu/Background/Margin]
Left=6
Right=6
Top=6
Bottom=6

[Menu/Background/OverlayClipMargin]
Left=0
Right=0
Top=0
Bottom=0

[Menu/Highlight]
Image=
Color=@selection@
BorderColor=@selection@
BorderWidth=0
Overlay=
Gravity="Top Left"
OverlayOffsetX=0
OverlayOffsetY=0
HideOverlayIfOversize=False

[Menu/Highlight/Margin]
Left=6
Right=6
Top=4
Bottom=4

[Menu/Highlight/OverlayClipMargin]
Left=0
Right=0
Top=0
Bottom=0
