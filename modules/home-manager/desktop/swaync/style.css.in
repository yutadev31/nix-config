:root {
  --bg: @bg@;
  --bg-strong: @black@;
  --bg-soft: @selection@;
  --fg: @fg@;
  --fg-muted: @white@;
  --blue: @blue@;
  --red: @red@;
  --cyan: @cyan@;
}

* {
  font-family: "Hack Nerd Font", FontAwesome, sans-serif;
  font-size: 12px;
  font-weight: bold;
  color: var(--fg);
}

.control-center {
  color: var(--fg);
  background-color: rgba(14, 17, 30, 0.8);
}

.notification-row {
  outline: none;
}

/* .notification-row:focus,
.notification-row:hover {
  background-color: rgba(32, 39, 70, 0.35);
} */

.notification-background {
  border-radius: 8px;
  margin: 12px;
  padding: 0;
}

.notification {
  background-color: var(--bg-strong);
  border: 1px solid var(--bg-soft);
  border-radius: 8px;
  margin: 6px;
  padding: 4px;
  box-shadow: none;
}

.notification.low {
  border-color: #3b4252;
}

.notification.critical {
  border-color: var(--red);
}

.notification-content {
  background-color: transparent;
}

.notification-default-action,
.notification-action {
  background-color: transparent;
  border-radius: 8px;
  border: 1px solid var(--bg-soft);
  padding: 6px;
  margin: 4px;
}

.notification-default-action:hover,
.notification-action:hover {
  border-color: var(--blue);
}

.summary {
  font-size: 13px;
  color: var(--fg);
}

.body {
  color: var(--fg-muted);
}

.time {
  color: var(--fg-muted);
}

.app-name {
  color: var(--cyan);
}

.close-button {
  background-color: var(--bg-soft);
  color: var(--fg);
  margin: 6px;
  padding: 2px;
  border-radius: 9999px;
}

.close-button:hover {
  background-color: var(--red);
}

.action-buttons {
  margin: 6px;
}
