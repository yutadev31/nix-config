* {
  bg: @bg@;
  bg-alt: @black@;
  bg-soft: @selection@;
  fg: @fg@;
  fg-muted: @white@;
  blue: @blue@;
  red: @red@;

  background-color: transparent;
}

window {
  location: center;
  anchor: center;
  width: 520px;
  background-color: @bg;
  border: 1px;
  border-color: @bg-soft;
  border-radius: 10px;
  padding: 10px;
}

mainbox {
  padding: 6px;
  spacing: 8px;
}

inputbar {
  background-color: @bg-alt;
  border-radius: 8px;
  padding: 6px 10px;
  spacing: 8px;
}

prompt {
  text-color: @blue;
}

textbox-prompt-colon {
  text-color: @blue;
}

entry {
  text-color: @fg;
  placeholder: "Search";
  placeholder-color: @fg-muted;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
  spacing: 6px;
}

element {
  padding: 6px 8px;
  border-radius: 8px;
}

element normal {
  text-color: @fg;
}

element alternate {
  text-color: @fg;
}

element selected {
  background-color: @bg-soft;
  text-color: @fg;
}

element-icon {
  size: 20px;
  margin: 0 8px 0 0;
}

element-text {
  text-color: inherit;
}

message {
  background-color: @bg-alt;
  border-radius: 8px;
  padding: 8px;
}

error-message {
  background-color: @bg-alt;
  text-color: @red;
  border-radius: 8px;
  padding: 8px;
}
