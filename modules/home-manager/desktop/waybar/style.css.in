* {
  border: none;
  border-radius: 0;
  font-family: "Hack Nerd Font", FontAwesome, sans-serif;
  font-size: 13px;
  font-weight: bold;
}

#waybar {
  background: #0b0c14;
  color: #c9ccd9;
}

label.module,
box.module {
  padding: 4px 4px;
}

#workspaces button {
  padding: 0 4px;
  margin: 0 2px;
  color: #c9ccd9;
}

#workspaces button.active {
  color: #4d6aff;
}
