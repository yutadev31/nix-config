* {
  bg: #1a1b26;
  bg-alt: #16161e;
  fg: #c0caf5;
  fg-alt: #a9b1d6;
  accent: #7aa2f7;
  border: #3d59a1;

  background-color: transparent;
  text-color: @fg;
}

window {
  location: center;
  anchor: center;
  width: 520px;
  background-color: @bg;
  border: 2px;
  border-color: @border;
  padding: 10px;
}

mainbox {
  padding: 6px;
  spacing: 8px;
}

inputbar {
  background-color: @bg-alt;
  padding: 6px 10px;
  spacing: 8px;
  children: [ "prompt", "entry" ];
}

prompt {
  text-color: @accent;
}

textbox-prompt-colon {
  text-color: @accent;
  font: "bold 12";
}

entry {
  text-color: @fg;
  placeholder: "Search...";
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
  spacing: 6px;
  cycle: true;
}

element {
  background-color: transparent;
  padding: 6px 8px;
  spacing: 10px;
}

element normal.normal {
  text-color: @fg-alt;
}

element selected.normal {
  background-color: @bg-alt;
  text-color: @accent;
}

element-icon {
  size: 20px;
  margin: 0 8px 0 0;
}

element-text {
  text-color: inherit;
}
